{
  "name": "selfheal-playwright",
  "version": "0.1.0",
  "description": "Self-healing Playwright tests: an AI agent that repairs broken locators, verifies the fix on the live page, and opens a pull request for review.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx demo-app/server.ts",
    "dev:v2": "cross-env APP_VERSION=2 tsx demo-app/server.ts",
    "test": "playwright test",
    "test:v2": "cross-env APP_VERSION=2 playwright test",
    "test:agent": "vitest run --project unit",
    "test:e2e-mock": "vitest run --project e2e",
    "heal": "tsx src/cli/heal.ts",
    "compat": "tsx scripts/compat-report.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test:agent"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "cross-env": "^10.1.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.17.1"
}
