# Copy to .env (never commit .env). Both keys are optional:
# - without ANTHROPIC_API_KEY use `pnpm heal --provider mock`
# - without GITHUB_TOKEN the healer writes heal-pr.md instead of opening a PR
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Demo app: 1 = original markup, 2 = renamed ids/classes/button text
APP_VERSION=1
PORT=4173
